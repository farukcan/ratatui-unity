{
  "metadata": [
    {
      "src": [
        {
          "src": "../Packages/com.farukcan.ratatui.unity/Runtime",
          "files": [
            "**/*.cs"
          ]
        },
        {
          "src": "_unity-stubs",
          "files": [
            "**/*.cs"
          ]
        }
      ],
      "dest": "api",
      "disableGitFeatures": false,
      "disableDefaultFilter": false,
      "filter": "filterConfig.yml",
      "properties": {
        "TargetFramework": "netstandard2.1"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/**.yml",
          "api/index.md"
        ]
      },
      {
        "files": [
          "articles/**.md",
          "articles/**/toc.yml",
          "toc.yml",
          "index.md"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "rust/**",
          "images/**"
        ]
      }
    ],
    "globalMetadata": {
      "_appName": "ratatui-unity",
      "_appTitle": "ratatui-unity",
      "_enableSearch": true,
      "_appFooter": "ratatui-unity — Ratatui TUI in Unity via Rust FFI",
      "_gitContribute": {
        "repo": "https://github.com/farukcan/ratatui-unity",
        "branch": "main"
      }
    },
    "template": [
      "default",
      "modern"
    ],
    "dest": "_site",
    "xrefService": [
      "https://xref.docs.microsoft.com/query?uid={uid}"
    ]
  }
}
